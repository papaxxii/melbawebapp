{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/name-role-value": [
      "default",
      {
        "button-name": "on",
        "link-name": "on"
      }
    ],
    "axe/forms": [
      "default",
      {
        "label": "on",
        "select-name": "on"
      }
    ],
    "axe/language": [
      "default",
      {
        "html-has-lang": "on"
      }
    ],
    "disown-opener": "on",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "min-height: auto"
        ]
      }
    ]
  }
}